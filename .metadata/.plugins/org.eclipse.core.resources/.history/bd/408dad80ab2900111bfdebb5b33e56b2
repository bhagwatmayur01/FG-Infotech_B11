package com.threadDemo;

public class FabbonacySeries {

	public static void main(String[] args) {
		
		int num=122;
		int original=num;
		int rev=0;
		
		while(num!=0) {
			int digit = num%10;
			rev=rev*10+digit;
			num=num/10;
			
		}
		
		//check palindrome
		if(original==rev) {
			System.out.println("Number is palindrome");
		}
		else {
			System.out.println("Number is NOT palindrome");
		}
	}

}
