package Java;

public class StringDemo {

	public static void main(String[] args) {

		
		String s1="Welcome";
		System.out.println(s1.indexOf('e'));//1
		System.out.println(s1.indexOf('e',2));//6 starts searching from index 2

		int firstE=s1.indexOf('e');//
		int secondE=s1.indexOf('e',firstE+1);//
		System.out.println(secondE);//1

	}

}
